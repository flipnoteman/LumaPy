@final
class Context:
    """A GPU (or software Vulkan) device with its own batch of recorded operations."""

    def __new__(
        cls,
        device: _DeviceName | None = None,
        *,
        memory_budget: int | None = None,
        chunk_bytes: int | None = None,
        calibrate: bool | None = None,
        check_finite: bool | None = None,
        fast_math: bool | None = None,
        df_fma: bool | None = None,
    ) -> Self: ...
    @staticmethod
    def cpu() -> Context: ...
    @property
    def is_cpu(self) -> bool: ...
    @property
    def tuning_profile(self) -> str: ...
    @property
    def features(self) -> list[str]: ...
    @property
    def spilled_bytes(self) -> int: ...
    @property
    def profiling_supported(self) -> bool: ...
    def sync(self) -> None: ...
    def flush(self) -> None: ...
    def enable_profiling(self) -> None: ...
    def finish_profiling(self) -> Profile: ...
    def profile(self, f: Callable[[], _R]) -> tuple[_R, Profile]: ...

@final
class KernelTiming:
    """The GPU time of one kernel, summed over its launches; times in seconds."""

    @property
    def label(self) -> str: ...
    @property
    def launches(self) -> int: ...
    @property
    def total(self) -> float: ...
    @property
    def min(self) -> float: ...
    @property
    def max(self) -> float: ...
    @property
    def mean(self) -> float: ...

@final
class Profile:
    """GPU durations per kernel, measured with timestamp queries."""

    @property
    def kernels(self) -> list[KernelTiming]: ...
    @property
    def splits(self) -> list[str]: ...
    @property
    def total(self) -> float: ...
    @property
    def launches(self) -> int: ...
    def get(self, label: str) -> KernelTiming | None: ...

@final
class Scalar:
    """A 32-bit value read by kernels at run time; `set` changes it without recompiling."""

    def __new__(cls, value: float, dtype: _DTypeLike | None = None) -> Self: ...
    @property
    def dtype(self) -> str: ...
    def get(self) -> int | float: ...
    def set(self, value: float) -> None: ...

@final
class KernelView:
    """A strided read view of an array passed to a kernel; made by `lumapy.view`."""

@final
class Uniform:
    """A `f32`, `u32` or `i32` value passed to a kernel as a uniform."""

    def __new__(cls, value: float, dtype: _DTypeLike | None = None) -> Self: ...

_KernelArg: TypeAlias = Array | KernelView | Uniform | int | float

@final
class Kernel:
    """A compiled custom WGSL compute kernel."""

    def __new__(
        cls,
        source: str,
        entry: str = "main",
        workgroup: tuple[int, int, int] | list[int] | None = None,
        label: str | None = None,
        ctx: Context | None = None,
    ) -> Self: ...
    @property
    def bindings(self) -> list[dict[str, Any]]: ...
    @property
    def workgroup(self) -> list[int]: ...
    def launch(self, size: int | Sequence[int], *args: _KernelArg) -> None: ...
    def launch_raw(self, workgroups: Sequence[int], *args: _KernelArg) -> None: ...

